@model PersonalAccount.Models.PasswordChangeViewModel

<div class="container d-flex align-content-center justify-content-center mt-4">
    <div class="card w-50">
        <header class="card-header">
            <h1 class="text-center">
                Смена пароля
            </h1>
        </header>
        <form id="passwordChangeForm" class="card-body" method="post" asp-controller="Profile" asp-action="ChangePassword">
            <p class="text-center">Заполните поля для обновления пароля</p>
            
            <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
            
            <div class="mb-3">
                <label class="form-label" asp-for="OldPassword">Старый пароль</label>
                <input id="oldPasswordInput" class="form-control" asp-for="OldPassword" type="password" />
                <span class="text-danger small" asp-validation-for="OldPassword"></span>
            </div>
            
            <div class="mb-3">
                <label class="form-label" asp-for="NewPassword">Новый пароль</label>
                <input id="newPasswordInput" class="form-control" asp-for="NewPassword" type="password" />
                <span class="text-danger small" asp-validation-for="NewPassword"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="ConfirmPassword">Подтверждение нового пароля</label>
                <input class="form-control" asp-for="ConfirmPassword" type="password" />
                <span class="text-danger small" asp-validation-for="ConfirmPassword"></span>
            </div>
            
            <button class="btn btn-primary w-100" type="submit">Обновить пароль</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById("passwordChangeForm").addEventListener("submit", function (event) {
            const oldPassword = document.getElementById("oldPasswordInput").value;
            const newPassword = document.getElementById("newPasswordInput").value;
            const validationSpan = document.querySelector("[data-valmsg-for='NewPassword']");

            if (validationSpan) {
                validationSpan.innerText = "";
            }

            if (oldPassword && newPassword && oldPassword === newPassword) {
                event.preventDefault(); 
                
                if (validationSpan) {
                    validationSpan.innerText = "The new password must not be the same as the old password";
                }
            }
        });
    </script>
}
