@model EditTeacherViewModel


<div class="container d-flex flex-column align-items-stretch gap-5">
    <div class="d-flex flex-column align-items-stretch gap-3">
        @foreach (var disciplineId in Model.DisciplineIdsOrder)
        {
            var discipline = Model.Disciplines[disciplineId];
            var groups = Model.GroupsByDisciplines[disciplineId];
            <div class="d-flex flex-column align-items-stretch gap-2">
                <h2 class="text-start fw-bold text-primary">@discipline.Name</h2>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var group in groups)
                    {
                        <form asp-action="RemoveTeacherGroupDiscipline"
                              class="card d-flex align-items-stretch justify-content-center"
                              style="width: 200px; background-image: url(@group.ImageUrl); background-size: cover; background-color: #2b2f32">
                            <input type="hidden" name="teacherAccountId" value="@Model.AccountId"/>
                            <input type="hidden" name="disciplineId" value="@discipline.Id"/>
                            <input type="hidden" name="groupId" value="@group.Id"/>
                            <div class="card-body d-flex text-white align-items-center justify-content-center">
                                <span class="text-center">@group.Name</span>
                            </div>
                            <button class="btn btn-outline-danger position-absolute" style="top: 10px; right: 10px;"><i
                                    class="bi bi-trash"></i></button>
                        </form>
                    }
                    @{
                        var groupOptions = Model.AllGroupOptions
                            .Where(groupOption => groups.All(group => groupOption.Id != group.Id))
                            .ToArray();
                        if (groupOptions.Any())
                        {
                            <form asp-action="AddTeacherGroupDiscipline" method="post">
                                <input type="hidden" name="teacherAccountId" value="@Model.AccountId"/>
                                <input type="hidden" name="disciplineId" value="@discipline.Id"/>
                                <div class="d-flex gap-2">
                                    <select class="form-control" name="groupId">
                                        @foreach (var groupOption in groupOptions)
                                        {
                                            <option value="@groupOption.Id">@groupOption.Name</option>
                                        }
                                    </select>
                                    <button class="btn btn-outline-primary" style="width: 200px">Добавить
                                    </button>
                                </div>
                            </form>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>